<%- include('../partials/header') %>

    <h1>Scenic Train Trips</h1>

    <%# Region and season filtering moves to the server in the next PR (W05 FS1 search and filtering);
        filtering one page of results in the browser would hide trips on other pages. %>
    <div id="filters" hidden>
        Search by Region:
        <select id="region-filter">
            <option value="all">All Regions</option>
        </select>

        Search by Season:
        <select id="season-filter">
            <option value="all">Any Season</option>
        </select>
    </div>

    <div class="trips-state" id="trips-loading">
        Loading trips...
    </div>

    <div class="trips-state" id="trips-error" hidden></div>

    <div class="trips-state" id="trips-empty" hidden>
        No trips match your selected filters.
    </div>

    <p class="trips-summary" id="trips-summary" aria-live="polite"></p>

    <div class="routes-grid" id="trips-list"></div>

    <nav class="trips-pagination" id="trips-pagination" aria-label="Trip pages" hidden>
        <button type="button" id="trips-prev">&larr; Previous</button>
        <span class="trips-page-status" id="trips-page-status" aria-live="polite"></span>
        <button type="button" id="trips-next">Next &rarr;</button>
    </nav>

    <template id="trip-card-template">
        <div class="route-card">
            <div class="route-header">
                <h2 class="route-name" data-field="name"></h2>
                <span class="route-region" data-field="region"></span>
            </div>

            <div class="station-info">
                <div class="station">
                    <div class="station-type">From:</div>
                    <div class="station-name" data-field="start-station"></div>
                </div>

                <div class="route-arrow">&#8594;</div>

                <div class="station">
                    <div class="station-type">To:</div>
                    <div class="station-name" data-field="end-station"></div>
                </div>
            </div>

            <div class="route-details">
                <div class="detail-item">
                    <span class="detail-icon">&#128337;</span>
                    <span>
                        <span class="detail-label">Duration:</span>
                        <span data-field="duration"></span>
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-icon">&#128205;</span>
                    <span>
                        <span class="detail-label">Distance:</span>
                        <span data-field="distance"></span>km
                    </span>
                </div>

                <div class="detail-item">
                    <span class="season-badge" data-field="season"></span>
                </div>
            </div>

            <div class="route-description" data-field="description"></div>

            <div class="highlights">
                <div class="highlights-list" data-field="highlights"></div>
            </div>

            <div class="route-actions">
                <a class="view-details-btn" data-field="details-link">
                    View Details &amp; Book &#8594;
                </a>
            </div>
        </div>
    </template>

    <script src="/js/trips-list.js"></script>

    <%- include('../partials/footer') %>